# Leave VITE_API_URL empty in local dev: the browser calls same-origin /api via the Vite proxy.
# API_PROXY_TARGET is that proxy upstream (host only; a trailing /api is stripped).
# API_PROXY_TARGET=http://localhost:4000
# VITE_API_URL=
# optional — бесплатный JS API работает и без ключа
# VITE_YANDEX_MAPS_API_KEY=
